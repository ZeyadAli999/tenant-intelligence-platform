# Application
APP_NAME=Multi-Tenant Text-to-SQL and Document Chat Platform
APP_VERSION=1.0.0
API_PREFIX=/api
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
DATABASE_ECHO=false

# Authentication - replace JWT_SECRET before starting the API.
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Customer database credentials - both safe defaults intentionally prevent access.
CONNECTION_ENCRYPTION_KEY=replace-with-a-base64url-encoded-32-byte-key
RESULT_MASKING_KEY=replace-with-at-least-32-random-bytes
ALLOW_PRIVATE_DATABASE_HOSTS=false
CUSTOMER_DATABASE_CONNECT_TIMEOUT_SECONDS=5
CUSTOMER_DATABASE_COMMAND_TIMEOUT_SECONDS=5
SAFE_QUERY_LOCK_TIMEOUT_MS=1000
SAFE_QUERY_MAX_ROWS=100
SAFE_QUERY_MAX_COLUMNS=50
SAFE_QUERY_MAX_RESULT_BYTES=1000000
SAFE_QUERY_MAX_CELL_LENGTH=4096
SAFE_QUERY_MAX_JOINS=8
SAFE_QUERY_MAX_SUBQUERY_DEPTH=4
SAFE_QUERY_MAX_CTES=5
SAFE_QUERY_MAX_SELECTED_COLUMNS=50

# Phase 3C-G Groq-only runtime. Replace the placeholder only in local .env.
GROQ_API_KEY=replace-with-your-local-groq-key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_OUTPUT_TOKENS=1200
GROQ_MAX_RETRIES=2
LLM_SCHEMA_MAX_TABLES=8
LLM_SCHEMA_MAX_COLUMNS=60
CHAT_MAX_MESSAGE_LENGTH=4000
CHAT_HISTORY_MESSAGES=10
CHAT_GRAPH_RECURSION_LIMIT=20

# Phase 4 document infrastructure. Replace credentials only in local .env.
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_BUCKET=documents
MINIO_ROOT_USER=replace-local-minio-root-user
MINIO_ROOT_PASSWORD=replace-local-minio-root-password
MINIO_APP_ACCESS_KEY=replace-local-minio-app-user
MINIO_APP_SECRET_KEY=replace-local-minio-app-password
MINIO_CONSOLE_PORT=9001
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_CACHE_DIR=/var/cache/fastembed
EMBEDDING_BATCH_SIZE=32
DOCUMENT_MAX_FILE_BYTES=26214400
DOCUMENT_MAX_EXTRACTED_CHARACTERS=5000000
DOCUMENT_MAX_PAGES=1000
DOCUMENT_MAX_SPREADSHEET_ROWS=100000
DOCUMENT_MAX_SPREADSHEET_CELLS=1000000
DOCUMENT_CHUNK_TARGET_TOKENS=450
DOCUMENT_CHUNK_OVERLAP_TOKENS=60
DOCUMENT_MAX_CHUNKS_PER_FILE=10000
DOCUMENT_DENSE_CANDIDATES=30
DOCUMENT_LEXICAL_CANDIDATES=30
DOCUMENT_FINAL_TOP_K=8
DOCUMENT_MIN_RELEVANCE=0.15
DOCUMENT_MAX_EVIDENCE_CHARACTERS=24000

# PostgreSQL development values - replace the password outside local development.
POSTGRES_DB=text_to_sql
POSTGRES_USER=text_to_sql
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://text_to_sql:change-me@localhost:5432/text_to_sql

# API port exposed by Docker Compose.
API_PORT=8000

# Disposable customer PostgreSQL used only with docker-compose.integration.yml.
CUSTOMER_POSTGRES_DB=customer_demo
CUSTOMER_POSTGRES_OWNER_USER=customer_owner
CUSTOMER_POSTGRES_OWNER_PASSWORD=change-owner-password
CUSTOMER_POSTGRES_READER_USER=customer_reader
CUSTOMER_POSTGRES_READER_PASSWORD=change-reader-password
